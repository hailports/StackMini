<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.zoom-session-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/home/operator/hailports-stack/tools/zoom_session_watchdog.py</string>
    <string>tick</string>
  </array>
  <key>WorkingDirectory</key><string>/home/operator/hailports-stack</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONPATH</key><string>/home/operator/hailports-stack</string>
  </dict>
  <key>StartInterval</key><integer>180</integer>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>5</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/home/operator/Library/Logs/hailports/zoom-session-watchdog.out</string>
  <key>StandardErrorPath</key><string>/home/operator/Library/Logs/hailports/zoom-session-watchdog.err</string>
</dict>
</plist>
