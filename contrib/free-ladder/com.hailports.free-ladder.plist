<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hailports.free-ladder</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; [ -f "$HOME/.config/free-llm/keys.env" ] &amp;&amp; . "$HOME/.config/free-llm/keys.env"; set +a; export PYTHONPATH="$HOME/claude-stack${PYTHONPATH:+:$PYTHONPATH}"; exec /usr/bin/python3 -m core.free_ladder --serve --port 8790 --bind 127.0.0.1,127.0.0.1</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/user/claude-stack</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/user/Library/Logs/claude-stack/free-ladder.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/user/Library/Logs/claude-stack/free-ladder.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/user</string>
    <key>CLAUDE_STACK_HOME</key>
    <string>/Users/user/claude-stack</string>
    <key>PYTHONPATH</key>
    <string>/Users/user/claude-stack</string>
    <key>PLUGSKY_MODEL</key>
    <string>plugsky-ultra</string>
  </dict>
</dict>
</plist>
