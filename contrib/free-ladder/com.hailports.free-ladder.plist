<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hailports.free-ladder</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; [ -f "$HOME/.config/free-llm/keys.env" ] &amp;&amp; . "$HOME/.config/free-llm/keys.env"; set +a; export PYTHONPATH="$HOME/hailports${PYTHONPATH:+:$PYTHONPATH}"; exec /usr/bin/python3 -m hailports.free_ladder --serve --port 8790 --bind 127.0.0.1</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/tmp</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/tmp/hailports-free-ladder.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hailports-free-ladder.log</string>
</dict>
</plist>
