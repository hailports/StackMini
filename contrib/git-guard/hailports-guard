#!/bin/bash
# hailports-guard: refuse to publish commits whose identity is not the project
# identity, or whose messages or added lines carry private details.
#
#   hailports-guard pre-push <remote> <url>     (stdin: git pre-push ref lines)
#   hailports-guard verify <remote> [<ref>...]  (same checks, for push scripts)
#   hailports-guard audit [<dir> [<rev-args>]]  (identity check, default all history)
#
# Private terms (names, employers, hostnames) live outside the repo in
# $HAILPORTS_GUARD_CONF/deny.txt (substrings) and deny-words.txt (whole
# words), one per line. There is no inline allow marker. Fails closed.
set -u
set -o pipefail
OK_ID="HailPorts <noreply@hailports.com>"
CONF=${HAILPORTS_GUARD_CONF:-$HOME/.config/hailports-guard}
DENY="$CONF/deny.txt"          # fixed strings, any case, anywhere
WORDS="$CONF/deny-words.txt"   # fixed strings, any case, whole words only
ZERO="$(printf '%040d' 0)"
TMP=$(mktemp -d "${TMPDIR:-/tmp}/hpguard.XXXXXX") || { echo "hailports-guard: BLOCKED: no temp dir" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT
BAD=0
say() { echo "hailports-guard: $*" >&2; }
bad() { say "BLOCKED: $*"; BAD=1; }

TAILNET_IP='(^|[^0-9.])100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}([^0-9]|$)'
# Machine names: hyphenated *.local names (code like self.local stays fine) and tailnet names.
HOSTNAME_RE='(^|[^/A-Za-z0-9_.-])[A-Za-z0-9]+-[A-Za-z0-9-]*\.local([^A-Za-z0-9_-]|$)|[A-Za-z0-9-]+\.ts\.net'
HOME_RE='(/Users|/home)/[A-Za-z0-9._-]+'
HOME_OK='(/Users|/home)/(you|me|x|user|username|name|runner|operator|example|someone|alice|bob)([^A-Za-z0-9._-]|$)'
EMAIL_RE='[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+'
TRAILER_RE='^(signed-off-by|co-authored-by|reviewed-by|acked-by|tested-by|reported-by|helped-by|suggested-by|cc):'

deny_ok() { [ -s "$DENY" ]; }

# Scan text in file $1, labelled $2, for private details.
scan_text() {
  f=$1; label=$2
  if deny_ok && grep -i -F -q -f "$DENY" "$f"; then bad "$label: private term"; fi
  if [ -s "$WORDS" ] && grep -i -w -F -q -f "$WORDS" "$f"; then bad "$label: private name"; fi
  if grep -E -q "$TAILNET_IP" "$f"; then bad "$label: tailnet IP"; fi
  if grep -E -i -q "$HOSTNAME_RE" "$f"; then bad "$label: hostname"; fi
  if grep -E -o "$HOME_RE" "$f" | grep -E -v -q "$HOME_OK"; then bad "$label: home path"; fi
}

check_ident() {  # $1 label, $2 "Name <email>"
  [ "$2" = "$OK_ID" ] || bad "$1 is not the project identity"
}

check_commit() {
  c=$1; full=$2; short=$(echo "$c" | cut -c1-12)
  info=$(git log -1 --format='%an <%ae>%x09%cn <%ce>' "$c") || { bad "$short: unreadable"; return; }
  check_ident "$short author" "${info%%$'\t'*}"
  check_ident "$short committer" "${info#*$'\t'}"
  git log -1 --format=%B "$c" > "$TMP/msg" || { bad "$short: no message"; return; }
  grep -E -i "$TRAILER_RE" "$TMP/msg" | sed -E 's/^[^:]+:[[:space:]]*//; s/[[:space:]]+$//' > "$TMP/tr"
  while IFS= read -r t; do check_ident "$short trailer" "$t"; done < "$TMP/tr"
  grep -E -o "$EMAIL_RE" "$TMP/msg" | grep -v -x -F 'noreply@hailports.com' > "$TMP/em"
  [ -s "$TMP/em" ] && bad "$short message: email address"
  if [ "$full" = 1 ]; then
    scan_text "$TMP/msg" "$short message"
    git diff-tree -r -p -U0 --no-color --no-ext-diff --root --no-commit-id "$c" > "$TMP/diff" || { bad "$short: no diff"; return; }
    grep '^+' "$TMP/diff" | grep -v '^+++ ' > "$TMP/add"
    grep -E '^(\+\+\+|---) ' "$TMP/diff" | grep -v '/dev/null' >> "$TMP/add"
    scan_text "$TMP/add" "$short added lines"
  fi
}

check_tag() {  # annotated tag object
  t=$1
  tg=$(git cat-file -p "$t" | sed -n 's/^tagger \(.*>\) [0-9]* [-+0-9]*$/\1/p')
  check_ident "tag $t tagger" "$tg"
  git cat-file -p "$t" | sed '1,/^$/d' > "$TMP/tmsg"
  scan_text "$TMP/tmsg" "tag message"
}

# Visibility decides how much content scanning a repo gets. Only a repo the
# hailports account confirms is private skips the content checks; anything
# else (public, unknown, offline) gets the full scan.
repo_is_private() {
  slug=$(echo "$1" | sed -E -n 's#.*github\.com[:/]hailports/([^/ ]+)$#\1#p' | sed 's/\.git$//')
  [ -n "$slug" ] || return 1
  command -v gh >/dev/null 2>&1 || return 1
  tok=$(gh auth token --user hailports 2>/dev/null) || return 1
  [ -n "$tok" ] || return 1
  v=$(GH_TOKEN=$tok gh api "repos/hailports/$slug" --jq .private 2>/dev/null) || return 1
  [ "$v" = true ]
}

run_checks() {  # $1 remote, $2 url, stdin ref lines
  remote=$1; url=$2
  case "$url" in
    *github.com[:/]hailports/*) ;;
    *) exit 0 ;;
  esac
  full=1
  if repo_is_private "$url"; then full=0; say "private repo: identity and secret checks only"; fi
  if [ "$full" = 1 ] && ! deny_ok; then bad "missing private term list $DENY"; fi
  : > "$TMP/commits"
  : > "$TMP/excl"
  while read -r lref lsha rref rsha; do
    [ -n "${lsha:-}" ] || continue
    [ "$lsha" = "$ZERO" ] && continue
    if [ "$(git cat-file -t "$lsha" 2>/dev/null)" = tag ]; then check_tag "$lsha"; fi
    ex="--not --remotes=$remote"
    if [ "${rsha:-$ZERO}" != "$ZERO" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then ex="$ex $rsha"; fi
    git rev-list "$lsha^{commit}" $ex >> "$TMP/commits" || bad "cannot list commits for $lref"
    echo "$lsha^{commit} $ex" >> "$TMP/excl"
  done
  sort -u "$TMP/commits" -o "$TMP/commits"
  n=$(wc -l < "$TMP/commits" | tr -d ' ')
  while read -r c; do check_commit "$c" "$full"; done < "$TMP/commits"
  if [ "$n" -gt 0 ]; then
    gl=$(command -v gitleaks || true)
    if [ -z "$gl" ]; then
      bad "gitleaks not installed"
    else
      while read -r spec; do
        if ! "$gl" git --no-banner --redact --log-opts="$spec" . > "$TMP/gl" 2>&1; then
          grep -E 'RuleID|File|Commit' "$TMP/gl" >&2; bad "gitleaks finding"
        fi
      done < "$TMP/excl"
    fi
  fi
  if [ "$BAD" != 0 ]; then say "push refused. Fix the commits (identity must be $OK_ID)."; exit 1; fi
  say "ok ($n new commit(s) checked)"
  exit 0
}

cmd=${1:-}; shift || true
case "$cmd" in
  pre-push) run_checks "${1:?remote}" "${2:-$1}" ;;
  verify)
    remote=${1:?remote}; shift
    url=$(git remote get-url --push "$remote" 2>/dev/null || echo "$remote")
    [ $# -gt 0 ] || set -- HEAD
    for r in "$@"; do
      sha=$(git rev-parse --verify "$r") || { say "BLOCKED: bad ref $r"; exit 1; }
      dst=$(git rev-parse --abbrev-ref "$r@{upstream}" 2>/dev/null | sed "s#^$remote/##")
      rs=$( [ -n "$dst" ] && git rev-parse --verify -q "refs/remotes/$remote/$dst" || echo $ZERO)
      echo "$r $sha refs/heads/${dst:-x} $rs"
    done | run_checks "$remote" "$url" ;;
  audit)
    cd "${1:-.}" || exit 1
    shift || true
    [ $# -gt 0 ] || set -- --all
    git log --format='%H %an <%ae>%x09%cn <%ce>' "$@" > "$TMP/ids" || exit 1
    while IFS=$'\t' read -r a cm; do
      h=${a%% *}; check_ident "${h:0:12} author" "${a#* }"; check_ident "${h:0:12} committer" "$cm"
    done < "$TMP/ids"
    git log --format=%B "$@" | grep -E -i "$TRAILER_RE" | sed -E 's/^[^:]+:[[:space:]]*//; s/[[:space:]]+$//' | sort -u > "$TMP/tr"
    while IFS= read -r t; do check_ident "trailer" "$t"; done < "$TMP/tr"
    [ "$BAD" = 0 ] && say "audit ok: $(wc -l < "$TMP/ids" | tr -d ' ') commits"
    exit $BAD ;;
  *) echo "usage: hailports-guard pre-push|verify|audit" >&2; exit 2 ;;
esac
